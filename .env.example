# Copy this file to .env and fill in real values - .env itself is gitignored.

# PostgreSQL connection string (see docs/setup.md for how to get one running).
DATABASE_URL="postgresql://bubbles:bubbles@localhost:5432/bubbles"

# NextAuth v5 signing secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Optional - overrides the dev seed account created by `npm run db:seed`
# (defaults are in prisma/seed.ts if these are left unset).
SEED_USER_EMAIL="admin@example.com"
SEED_USER_PASSWORD="endre-meg-nå"
