# Copy this file to .env and fill in real values - .env itself is gitignored.

# PostgreSQL connection string. The local dev database runs in Docker:
#   docker run --name bubbles-postgres -e POSTGRES_PASSWORD=devpassword \
#     -p 5433:5432 -d postgres:17
DATABASE_URL="postgresql://postgres:devpassword@localhost:5433/bubbles"

# NextAuth v5 signing secret - REQUIRED. Without it every auth request fails
# with "There is a problem with the server configuration". Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Trust the incoming Host header. NextAuth only does this automatically when
# NODE_ENV is not "production", so without it a production build (`npm run
# build && npm start`) rejects every auth request with the same "problem with
# the server configuration" page. Required for any self-hosted deployment;
# set AUTH_URL to the canonical public URL instead if you prefer to pin it.
AUTH_TRUST_HOST=true

# Dev login accounts are defined in src/data/domainData.json under
# "devSeedUsers" and created by `npm run db:seed` - currently
# admin1@example.com .. admin5@example.com, passwords "endre-meg-nå-1".."-5".
# Change them there, not here.
